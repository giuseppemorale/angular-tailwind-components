{
  "name": "angular-tailwind-components",
  "version": "22.0.0",
  "description": "Angular UI component library built with Tailwind CSS v4 — signals, standalone components, 40+ components.",
  "author": "Giuseppe Morale",
  "license": "LicenseRef-ATC-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/giuseppemorale/angular-tailwind-components"
  },
  "homepage": "https://github.com/giuseppemorale/angular-tailwind-components",
  "bugs": {
    "url": "https://github.com/giuseppemorale/angular-tailwind-components/issues",
    "email": "morale-giuseppe@live.it"
  },
  "keywords": [
    "angular",
    "tailwind",
    "components"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve playground",
    "build": "node scripts/copy-icons.js sync && ng build angular-tailwind-components && node scripts/copy-icons.js dist",
    "sync-icons": "node scripts/copy-icons.js sync",
    "watch": "node scripts/copy-icons.js sync && ng build angular-tailwind-components --watch --configuration development && node scripts/copy-icons.js dist",
    "test": "ng test",
    "release": "node scripts/release.js",
    "publish:dist": "npm run build && npm publish --access public --prefix dist/angular-tailwind-components",
    "storybook": "ng run angular-tailwind-components:storybook",
    "build:storybook": "ng run angular-tailwind-components:build-storybook",
    "prettier:write": "prettier --write projects/**/*.{ts,html,css} src/**/*.{ts,html,css}",
    "prettier:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2201.2",
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular-devkit/core": "^22.1.2",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@compodoc/compodoc": "^2.0.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@jsverse/transloco": "^8.4.0",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-onboarding": "^10.5.6",
    "@storybook/angular": "^10.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "storybook": "^10.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
